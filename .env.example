# Database. The app connects as hangar_app; migrations run as the owner.
DATABASE_URL=postgres://user:pass@localhost:5432/hangar

# Signs the session cookie. At least 32 characters. Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
HANGAR_SESSION_SECRET=

# Shared secret between the server and the companion process.
# Whoever holds this can post as the agent into any room. Treat it as a deploy key.
HANGAR_COMPANION_TOKEN=

# Where the server listens. Keep it on localhost behind a TLS terminator.
PORT=4000
HANGAR_BIND=127.0.0.1

# Email-only sign-in with no password. ONLY set this behind something that
# already authenticates, such as an SSO proxy on a private network.
HANGAR_TRUSTED_LOGIN=false

# Set true only when serving over plain http on a trusted network, which drops
# the Secure flag from the session cookie.
HANGAR_INSECURE_COOKIES=false

# --- companion process (a developer's own machine) ---
HANGAR_URL=http://127.0.0.1:4000
HANGAR_REPO=/path/to/the/repository/the/agent/works/in
# Each session runs in a git worktree under .hangar-worktrees/ inside that repo.
# Add that path to the repo's .gitignore or it shows up as untracked.
# The worktree is deleted when the session ends. The branch it committed to,
# hangar/<dispatch-id>, stays so you can review or delete it.
HANGAR_POLL_SECONDS=5
